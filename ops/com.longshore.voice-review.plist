<?xml version="1.0" encoding="UTF-8"?>
<!-- LONGSHORE voice-review organ (monthly). Install:
       cp ops/com.longshore.voice-review.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.longshore.voice-review.plist
     Uninstall: launchctl unload ~/Library/LaunchAgents/com.longshore.voice-review.plist
     Runs on the 1st of each month (when the Mac is awake). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.longshore.voice-review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/chaytaninman/code/slop/ops/voice-review.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>15</integer>
    <key>Minute</key><integer>23</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/chaytaninman/code/slop/.secrets/voice-review.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/chaytaninman/code/slop/.secrets/voice-review.launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
